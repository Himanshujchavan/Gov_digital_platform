# ============================================================
# Environment Configuration for Maharashtra Interoperability Middleware
# ============================================================
# IMPORTANT: Copy this file to .env and fill in real values.
# NEVER commit a .env file with real secrets to version control.
# ============================================================

NODE_ENV=development

# ─── Ports ───────────────────────────────────────────────────
GATEWAY_PORT=8000
AUTH_PORT=8001
DEPARTMENTS_PORT=8002
ADAPTERS_PORT=8003
MDM_PORT=8004
CONSENT_PORT=8005
WORKFLOW_PORT=8006
AUDIT_PORT=8007

# ─── PostgreSQL Database ─────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=maha_interop

# ─── MongoDB Database (Audit Log) ────────────────────────────
MONGODB_URI=mongodb://localhost:27017/maha_interop_audit

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# ─── JWT / Security (Asymmetric RS256) ────────────────────────
# Generate a key pair:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -pubout -in private.pem -out public.pem
# Then paste the PEM contents below (use \n for newlines).
JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n<PASTE_YOUR_PRIVATE_KEY>\n-----END PRIVATE KEY-----
JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n<PASTE_YOUR_PUBLIC_KEY>\n-----END PUBLIC KEY-----
JWT_ALGORITHM=RS256
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000

# ─── Rate Limiting ───────────────────────────────────────────
# Global: max requests per TTL window (seconds)
RATE_LIMIT_TTL=60
RATE_LIMIT_GLOBAL=60
# Auth-specific: stricter limits for login/register/refresh
RATE_LIMIT_AUTH=5
RATE_LIMIT_AUTH_TTL=60

# ─── JWKS Cache ──────────────────────────────────────────────
# How long (ms) the gateway caches the public key from JWKS endpoint
JWKS_CACHE_TTL_MS=3600000

# ─── Password Hashing ───────────────────────────────────────
BCRYPT_ROUNDS=12

# ─── Seed Data (development only — ignored in production) ────
SEED_DEFAULT_PASSWORD=Dev_P@ssw0rd_2026!

# ─── Microservice URLs (Internal Communication) ─────────────
AUTH_SERVICE_URL=http://localhost:8001
DEPARTMENTS_SERVICE_URL=http://localhost:8002
ADAPTERS_SERVICE_URL=http://localhost:8003
MDM_SERVICE_URL=http://localhost:8004
CONSENT_SERVICE_URL=http://localhost:8005
WORKFLOW_SERVICE_URL=http://localhost:8006
AUDIT_SERVICE_URL=http://localhost:8007
