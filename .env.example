# Environment Configuration for Maharashtra Interoperability Middleware
NODE_ENV=development

# Ports
GATEWAY_PORT=8000
AUTH_PORT=8001
DEPARTMENTS_PORT=8002
ADAPTERS_PORT=8003
MDM_PORT=8004
CONSENT_PORT=8005
WORKFLOW_PORT=8006
AUDIT_PORT=8007

# PostgreSQL Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=maha_interop

# MongoDB Database (Audit Log)
MONGODB_URI=mongodb://localhost:27017/maha_interop_audit

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# Security & JWT
JWT_SECRET=maha_gov_interop_super_secret_jwt_key_2026
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Microservice URLs (Internal Communication)
AUTH_SERVICE_URL=http://localhost:8001
DEPARTMENTS_SERVICE_URL=http://localhost:8002
ADAPTERS_SERVICE_URL=http://localhost:8003
MDM_SERVICE_URL=http://localhost:8004
CONSENT_SERVICE_URL=http://localhost:8005
WORKFLOW_SERVICE_URL=http://localhost:8006
AUDIT_SERVICE_URL=http://localhost:8007
