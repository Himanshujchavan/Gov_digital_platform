{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./",
    "baseUrl": "./",
    "ignoreDeprecations": "6.0",
    "checkJs": false
  },
  "include": [
    "src/**/*",
    "**/*.js"
  ]
}
